# ===========================================
# CONFIGURACIÓN DE ALTITUDE LOGISTICS
# ===========================================

# Supabase - Base de datos para leads
# Obtener de: supabase.com > Tu proyecto > Settings > API
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Admin Panel - Contraseña para acceder a /admin
VITE_ADMIN_PASSWORD=tu_contraseña_segura

# Webhook (opcional) - Para enviar datos a n8n, Make, Zapier, etc.
VITE_WEBHOOK_URL=https://tu-webhook-url.com/webhook

# ===========================================
# INSTRUCCIONES:
# 1. Copia este archivo a .env
# 2. Completa con tus valores
# 3. Reinicia el servidor de desarrollo
# ===========================================
